<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>売上・粗利 貼り付け</title>
<style>
  html, body { margin: 0; padding: 0; background: #f6f3ee; font-family: -apple-system, 'Hiragino Sans', 'Yu Gothic', sans-serif; color: #1f1c18; }
  #root { min-height: 100vh; }
</style>
</head>
<body>
<div id="root"></div>
<script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
<script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
<script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
<script type="text/babel" data-presets="react">
const { useState } = React;

const GAS_SHEET_WEBAPP_URL = "https://script.google.com/macros/s/AKfycby8ysGEkzP2zG2p_ReQsPieG68R6qKC7TNT41x3Ql5skEzE81d5q6UQVxT_QCAjMjlUkA/exec";

function todayStr() {
  const d = new Date();
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, "0");
  const day = String(d.getDate()).padStart(2, "0");
  return `${y}-${m}-${day}`;
}
function offsetDateStr(baseDateStr, deltaDays) {
  const d = new Date(baseDateStr + "T00:00:00");
  d.setDate(d.getDate() + deltaDays);
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, "0");
  const day = String(d.getDate()).padStart(2, "0");
  return `${y}-${m}-${day}`;
}
function fmtDateJp(dateStr) {
  const WEEKDAYS = ["日", "月", "火", "水", "木", "金", "土"];
  const d = new Date(dateStr + "T00:00:00");
  return `${d.getMonth() + 1}/${d.getDate()}(${WEEKDAYS[d.getDay()]})`;
}

async function fetchWithTimeout(url, options, timeoutMs) {
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), timeoutMs || 15000);
  try {
    return await fetch(url, { ...options, signal: controller.signal });
  } catch (e) {
    if (e && e.name === "AbortError") {
      throw new Error("通信がタイムアウトしました(スプレッドシート側の応答がありません)");
    }
    throw e;
  } finally {
    clearTimeout(timer);
  }
}

async function gasGet(key) {
  const res = await fetchWithTimeout(GAS_SHEET_WEBAPP_URL, {
    method: "POST",
    headers: { "Content-Type": "text/plain;charset=utf-8" },
    body: JSON.stringify({ action: "get", key }),
  });
  const json = await res.json();
  if (!json || !json.ok || json.value === null || json.value === undefined) return null;
  return json.value;
}

async function copyToClipboard(text) {
  try {
    const writePromise = navigator.clipboard.writeText(text);
    const timeoutPromise = new Promise((_, reject) =>
      setTimeout(() => reject(new Error("clipboard timeout")), 4000)
    );
    await Promise.race([writePromise, timeoutPromise]);
    return true;
  } catch (e) {
    try {
      const ta = document.createElement("textarea");
      ta.value = text;
      ta.style.position = "fixed";
      ta.style.opacity = "0";
      document.body.appendChild(ta);
      ta.focus();
      ta.select();
      document.execCommand("copy");
      document.body.removeChild(ta);
      return true;
    } catch (e2) {
      return false;
    }
  }
}

function App() {
  const [start, setStart] = useState(() => offsetDateStr(todayStr(), -6));
  const [end, setEnd] = useState(() => todayStr());
  const [busy, setBusy] = useState(false);
  const [notice, setNotice] = useState("");
  const [error, setError] = useState("");
  const [previewText, setPreviewText] = useState("");
  const [flash, setFlash] = useState("");

  const fetchValues = async () => {
    const dateList = [];
    let cursor = start;
    while (cursor <= end) {
      dateList.push(cursor);
      cursor = offsetDateStr(cursor, 1);
    }
    const totals = [];
    const profits = [];
    for (const ds of dateList) {
      let t = 0;
      let g = 0;
      try {
        const raw = await gasGet(`simplereport:${ds}`);
        if (raw) {
          const rep = JSON.parse(raw);
          t = Number(rep.totalSales) || 0;
          g = Number(rep.grossProfit) || 0;
        }
      } catch (e) {
        // 取得失敗はこの日だけ0扱い
      }
      totals.push(t);
      profits.push(g);
    }
    return { totals, profits, count: dateList.length };
  };

  const copyColumn = async (which) => {
    setError("");
    setNotice("");
    if (start > end) {
      setError("開始日が終了日より後になっています。日付を確認してください。");
      return;
    }
    setBusy(true);
    try {
      const { totals, profits, count } = await fetchValues();
      const values = which === "sales" ? totals : profits;
      const text = values.join("\n");
      setPreviewText(text);
      const ok = await copyToClipboard(text);
      const label = which === "sales" ? "売上" : "粗利";
      if (ok) {
        setFlash(which);
        setNotice(
          `${fmtDateJp(start)}〜${fmtDateJp(end)}の${label}(${count}日分)をコピーしました。スプレッドシートの${label}列・開始日のセルを選んで貼り付けてください。`
        );
        setTimeout(() => setFlash(""), 2500);
      } else {
        setError("コピーに失敗しました。下のテキストを長押しして手動でコピーしてください。");
      }
    } catch (e) {
      setError("取得に失敗しました。" + (e && e.message ? `(${e.message})` : ""));
    } finally {
      setBusy(false);
    }
  };

  return (
    <div style={{ maxWidth: 480, margin: "0 auto", padding: "24px 16px 48px" }}>
      <header style={{ borderBottom: "2px solid #1f1c18", paddingBottom: 16, marginBottom: 20 }}>
        <div style={{ fontSize: 11, letterSpacing: "0.12em", color: "#8a6f4e", fontWeight: 700 }}>
          SALES / PROFIT PASTE
        </div>
        <h1 style={{ fontSize: 24, fontWeight: 800, margin: "4px 0 0" }}>売上・粗利 貼り付け</h1>
      </header>

      {error && (
        <div style={{ background: "#fbe2dc", color: "#8c2f1b", padding: "10px 14px", borderRadius: 6, marginBottom: 16, fontSize: 14 }}>
          {error}
        </div>
      )}

      <section style={{ background: "#fffdf9", border: "1px solid #e4ddd0", borderRadius: 10, padding: 16 }}>
        <p style={{ fontSize: 12, color: "#8a8272", marginTop: 0 }}>
          期間を選んで、売上・粗利をそれぞれ別にコピーしてください(1列ずつ)。データはdashi-close2アプリで保存した内容から取得します。
        </p>
        <div style={{ display: "flex", alignItems: "center", gap: 8, margin: "10px 0" }}>
          <input
            type="date"
            value={start}
            max={end}
            onChange={(e) => e.target.value && setStart(e.target.value)}
            style={{ flex: 1, border: "1px solid #d8cfbe", borderRadius: 8, padding: "8px 10px", fontSize: 14, background: "#fff" }}
          />
          <span style={{ color: "#8a8272" }}>〜</span>
          <input
            type="date"
            value={end}
            min={start}
            max={todayStr()}
            onChange={(e) => e.target.value && setEnd(e.target.value)}
            style={{ flex: 1, border: "1px solid #d8cfbe", borderRadius: 8, padding: "8px 10px", fontSize: 14, background: "#fff" }}
          />
        </div>
        <button
          onClick={() => copyColumn("sales")}
          disabled={busy}
          style={{ width: "100%", padding: "12px 12px", background: "#2f6d4f", color: "#fff", border: "none", borderRadius: 8, fontSize: 14, fontWeight: 700, cursor: "pointer", marginTop: 8 }}
        >
          {busy ? "作成中..." : flash === "sales" ? "✓ コピーしました" : "① 売上だけコピー"}
        </button>
        <button
          onClick={() => copyColumn("profit")}
          disabled={busy}
          style={{ width: "100%", padding: "12px 12px", background: "#2f6d4f", color: "#fff", border: "none", borderRadius: 8, fontSize: 14, fontWeight: 700, cursor: "pointer", marginTop: 8 }}
        >
          {busy ? "作成中..." : flash === "profit" ? "✓ コピーしました" : "② 粗利だけコピー"}
        </button>
        {notice && <p style={{ fontSize: 12, color: "#2f6d4f", fontWeight: 600, marginBottom: 0 }}>{notice}</p>}
        {previewText && (
          <pre style={{ whiteSpace: "pre-wrap", wordBreak: "break-all", background: "#faf7f0", border: "1px solid #e4ddd0", borderRadius: 8, padding: "10px 12px", fontSize: 13, marginTop: 10 }}>
            {previewText}
          </pre>
        )}
      </section>
    </div>
  );
}

const root = ReactDOM.createRoot(document.getElementById('root'));
root.render(<App />);
</script>
</body>
</html>
